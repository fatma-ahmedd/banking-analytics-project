/* creting bronze layer tables
droping tables if they are already exist

run this script to re-define the ddl structure of 'bronze' tables 
*/ 


USE [banking project]
GO


if OBJECT_ID('[bronze].[transactions]', 'U') IS NOT NULL
	DROP TABLE [bronze].[transactions];

CREATE TABLE [bronze].[transactions](
	[TransactionID] [int] NOT NULL,
	[AccountOriginID] [int] NOT NULL,
	[AccountDestinationID] [int] NOT NULL,
	[TransactionTypeID] [tinyint] NOT NULL,
	[Amount] [float] NOT NULL,
	[TransactionDate] [nvarchar](50) NULL,
	[BranchID] [tinyint] NOT NULL,
	[Description] [nvarchar](50) NOT NULL
) ON [PRIMARY]
GO

--------------------------------------------------------------

if OBJECT_ID('[bronze].[transaction_types]', 'U') IS NOT NULL
	DROP TABLE [bronze].[transaction_types];
GO

CREATE TABLE [bronze].[transaction_types](
	[TransactionTypeID] [tinyint] NOT NULL,
	[TypeName] [nvarchar](50) NOT NULL
) ON [PRIMARY]
GO

--------------------------------------------------------------

if OBJECT_ID('[bronze].[loans]', 'U') IS NOT NULL
	DROP TABLE [bronze].[loans];
GO

CREATE TABLE [bronze].[loans](
	[LoanID] [int] NOT NULL,
	[AccountID] [int] NOT NULL,
	[LoanStatusID] [tinyint] NOT NULL,
	[PrincipalAmount] [float] NOT NULL,
	[InterestRate] [float] NOT NULL,
	[StartDate] [nvarchar](50) NULL,
	[EstimatedEndDate] [nvarchar](50) NULL
) ON [PRIMARY]
GO

--------------------------------------------------------------


if OBJECT_ID('[bronze].[loan_statuses]', 'U') IS NOT NULL
	DROP TABLE [bronze].[loan_statuses];

	CREATE TABLE [bronze].[loan_statuses](
	[LoanStatusID] [tinyint] NOT NULL,
	[StatusName] [nvarchar](50) NOT NULL
) ON [PRIMARY]
GO

--------------------------------------------------------------

if OBJECT_ID('[bronze].[customers]', 'U') IS NOT NULL
	DROP TABLE [bronze].[customers];
GO

CREATE TABLE [bronze].[customers](
	[CustomerID] [smallint] NOT NULL,
	[FirstName] [nvarchar](50) NULL,
	[LastName] [nvarchar](50) NULL,
	[DateOfBirth] [nvarchar](50) NOT NULL,
	[AddressID] [smallint] NOT NULL,
	[CustomerTypeID] [tinyint] NOT NULL
) ON [PRIMARY]
GO

---------------------------------------------------------------

if OBJECT_ID('[bronze].[customer_types]', 'U') IS NOT NULL
	DROP TABLE [bronze].[customer_types];
GO

CREATE TABLE [bronze].[customer_types](
	[CustomerTypeID] [tinyint] NOT NULL,
	[TypeName] [nvarchar](50) NOT NULL
) ON [PRIMARY]
GO

---------------------------------------------------------------

if OBJECT_ID('[bronze].[branches]', 'U') IS NOT NULL
	DROP TABLE [bronze].[branches];

	GO

CREATE TABLE [bronze].[branches](
	[BranchID] [tinyint] NOT NULL,
	[BranchName] [nvarchar](50) NOT NULL,
	[AddressID] [smallint] NOT NULL
) ON [PRIMARY]
GO

---------------------------------------------------------------

if OBJECT_ID('[bronze].[addresses]', 'U') IS NOT NULL
	DROP TABLE [bronze].[addresses];

	GO

CREATE TABLE [bronze].[addresses](
	[AddressID] [smallint] NOT NULL,
	[Street] [nvarchar](50) NULL,
	[City] [nvarchar](50) NULL,
	[Country] [nvarchar](50) NULL
) ON [PRIMARY]
GO

---------------------------------------------------------------

if OBJECT_ID('[bronze].[accounts]', 'U') IS NOT NULL
	DROP TABLE [bronze].[accounts];

	GO

CREATE TABLE [bronze].[accounts](
	[AccountID] [int] NOT NULL,
	[CustomerID] [smallint] NOT NULL,
	[AccountTypeID] [tinyint] NOT NULL,
	[AccountStatusID] [tinyint] NOT NULL,
	[Balance] [float] NOT NULL,
	[OpeningDate] [nvarchar](50) NULL
) ON [PRIMARY]
GO 

---------------------------------------------------------------

if OBJECT_ID('[bronze].[account_types]', 'U') IS NOT NULL
	DROP TABLE [bronze].[account_types];

	GO

CREATE TABLE [bronze].[account_types](
	[AccountTypeID] [tinyint] NOT NULL,
	[TypeName] [nvarchar](50) NOT NULL
) ON [PRIMARY]
GO
 
 ---------------------------------------------------------------

 if OBJECT_ID('[bronze].[account_statuses]', 'U') IS NOT NULL
	DROP TABLE [bronze].[account_statuses];

	GO

CREATE TABLE [bronze].[account_statuses](
	[AccountStatusID] [tinyint] NOT NULL,
	[StatusName] [nvarchar](50) NOT NULL
) ON [PRIMARY]
GO

---------------------------------------------------------------



create or alter procedure bronze.load_data as 

 begin try 
 print '========================================';
