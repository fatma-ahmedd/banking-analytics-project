-- [ 01 ]transaction table --

SELECT AccountDestinationID
FROM bronze.transactions as t
left join bronze.accounts as a
on t.AccountDestinationID = a.AccountID 
where a.Accountid is null ;

---------------------------------------

SELECT AccountOriginID
FROM bronze.transactions as t
left join bronze.accounts as a
on t.AccountOriginID = a.AccountID 
where a.Accountid is null;

---------------------------------------

WITH duplicate_transactions AS (
    SELECT TransactionID
    FROM bronze.transactions
    GROUP BY TransactionID
    HAVING COUNT(*) > 1
)
SELECT t.*
FROM bronze.transactions AS t
JOIN duplicate_transactions AS d
    ON t.TransactionID = d.TransactionID
    order by t.TransactionID;

-----------------------------------------

    SELECT
    TransactionID,
    AccountOriginID,
    AccountDestinationID,
    TransactionTypeID,
    Amount,
    TransactionDate,
    BranchID,
    Description,
    COUNT(*) AS duplicate_count
FROM bronze.transactions
GROUP BY
    TransactionID,
    AccountOriginID,
    AccountDestinationID,
    TransactionTypeID,
    Amount,
    TransactionDate,
    BranchID,
    Description
HAVING COUNT(*) > 1
order by TransactionID;

