-- [6] gold.fact_transactions --

CREATE VIEW gold.fact_transactions AS (

	SELECT  t.transactionid as transaction_id, 
			a.account_key as origin_key ,
			ad.account_key as destination_key,
			t.transactiontypeid as transaction_type_id,
			b.branch_key ,
			t.amount ,
			t.transactiondate as date 
		
		
	FROM silver.transactions as t
	LEFT JOIN gold.dim_branches as b
	ON t.BranchID=b.branch_id
	LEFT JOIN gold.dim_accounts as a 
	ON t.AccountOriginID=a.account_id
	LEFT JOIN gold.dim_accounts AS ad
	ON t.AccountDestinationID = ad.Account_ID) ;

GO 
-----------------------------------------------------------------
-- [7] gold.fact_loans --

CREATE VIEW gold.fact_loans AS(

	SELECT l.loanid as loan_id,
		   a.account_key,
		   l.loanstatusid as status_id,
		   l.principalamount as principal_amount ,
		   l.interestrate as interest_rate,
		   l.startdate as start_date ,
		   l.estimatedenddate as estimated_end_date

	FROM silver.loans as l 
	LEFT JOIN gold.dim_accounts as a
	ON a.account_id= l.accountid);

---------------------------------------------------------------------------------------

CREATE VIEW gold.dim_date AS

WITH DateRange AS (
    SELECT
        MIN(CAST(Date AS date)) AS StartDate,
        MAX(CAST(Date AS date)) AS EndDate
    FROM gold.fact_transactions
),

Numbers AS (
    SELECT TOP (
        DATEDIFF(
            DAY,
            (SELECT StartDate FROM DateRange),
            (SELECT EndDate FROM DateRange)
        ) + 1
    )
        ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) - 1 AS n
    FROM sys.all_objects a
    CROSS JOIN sys.all_objects b
),

Dates AS (
    SELECT
        DATEADD(DAY, n, StartDate) AS DateValue
    FROM Numbers
    CROSS JOIN DateRange
)

SELECT
    CONVERT(INT, CONVERT(CHAR(8), DateValue, 112)) AS DateKey,
    CAST(DateValue AS DATE) AS [Date],
    YEAR(DateValue) AS [Year],
    CONCAT('Q', DATEPART(QUARTER, DateValue)) AS [Quarter],
    MONTH(DateValue) AS MonthNumber,
    DATENAME(MONTH, DateValue) AS MonthName ,
    CONCAT(
    YEAR(DateValue),
    '-Q',
    DATEPART(QUARTER, DateValue)
) AS YearQuarter
FROM Dates;
