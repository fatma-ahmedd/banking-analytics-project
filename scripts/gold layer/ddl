/* use this script to create the gold layer (select specific columns 
and rename columns to fit with business requirements) */

-- [1] gold.dim_branches --

CREATE VIEW gold.dim_branches AS (

	SELECT  row_number() over(order by branchid asc ) as branch_key ,
			b.branchid as branch_id,
			b.branchname as branch_name,
			a.street ,
			a.city,
			a.country
	FROM silver.branches as b
	LEFT JOIN silver.addresses as a
	ON b.addressid = a.addressid ); 

	GO
-----------------------------------------------------------------
-- [2] gold.dim_transactiontypes --

CREATE VIEW gold.dim_transactiontypes AS (

	SELECT transactiontypeid as type_id ,
		   typename as type_name 
	FROM silver.transaction_types )


GO
----------------------------------------------------------------- 
-- [3] gold.dim_customers --

CREATE VIEW gold.dim_customers AS	 (

	SELECT row_number() over(order by customerid asc ) as customer_key ,
		   C.customerid as customer_id,
		   C.firstname as first_name,
		   C.lastname as last_name,
		   T.typename as customer_type,
		   A.street ,
		   A.city,
		   A.country ,
		   C.dateofbirth as birth_date


	FROM SILVER.CUSTOMERS AS C 
	LEFT JOIN SILVER.customer_types AS T 
	ON C.CUSTOMERTYPEID=T.CUSTOMERTYPEID
	LEFT JOIN SILVER.addresses AS A 
	ON C.ADDRESSID=A.ADDRESSID ) ;


	GO 
---------------------------------------------------------------------
-- [4] gold.dim_accounts --

CREATE VIEW gold.dim_accounts AS (

	SELECT  row_number() over(order by accountid asc ) as account_key ,
			a.accountid as account_id, 
			c.customer_key,
			t.typename as type_name ,
			s.statusname as status_name,
			a.balance ,
			a.openingdate as opening_date

	FROM silver.accounts as a 
	LEFT JOIN silver.account_types as t 
	ON a.accounttypeID=t.accounttypeID
	LEFT JOIN silver.account_statuses as s
	ON a.accountstatusid=s.accountstatusid 
	LEFT JOIN gold.dim_customers as c 
	ON c.customer_id = a.CustomerID ) ; 

	GO
