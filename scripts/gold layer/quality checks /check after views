/* use this script to check data quality after creating views */ 


-- [1] gold.dim_branches --
SELECT branch_id, COUNT(*) AS branch_count
FROM gold.dim_branches
GROUP BY branch_id
HAVING COUNT(*) > 1;
--------------------------------------------------------------
-- [2] gold.dim_transactionstypes --
SELECT type_id, COUNT(*) AS type_count
FROM gold.dim_transactiontypes
GROUP BY type_id
HAVING COUNT(*) > 1;
-------------------------------------------------------------
-- [3] gold.dim_customers --

SELECT customer_id, COUNT(*) AS customer_count
FROM gold.dim_customers
GROUP BY customer_id
HAVING COUNT(*) > 1;
---------------------------------------------------------
-- [4] gold.dim_accounts --
SELECT *
FROM gold.dim_accounts
WHERE customer_key IS NULL;


SELECT account_id, COUNT(*) AS account_count
FROM gold.dim_accounts
GROUP BY account_id
HAVING COUNT(*) > 1;

----------------------------------------------------------------
-- [5] gold.dim_loanstatus --
SELECT loanstatusid, COUNT(*) AS status_count
FROM gold.dim_loanstatus
GROUP BY loanstatusid
HAVING COUNT(*) > 1;
----------------------------------------------------------
-- [6] gold.fact_transactions --

SELECT transaction_id, COUNT(*) AS transaction_count
FROM gold.fact_transactions
GROUP BY transaction_id
HAVING COUNT(*) > 1;


SELECT *
FROM gold.fact_transactions
WHERE origin_key IS NULL
   OR destination_key IS NULL
   OR branch_key IS NULL;


SELECT f.origin_key
FROM gold.fact_transactions AS f
LEFT JOIN gold.dim_accounts AS a
    ON f.origin_key = a.account_key
WHERE a.account_key IS NULL;


SELECT f.destination_key
FROM gold.fact_transactions AS f
LEFT JOIN gold.dim_accounts AS a
    ON f.destination_key = a.account_key
WHERE a.account_key IS NULL;


SELECT f.branch_key
FROM gold.fact_transactions AS f
LEFT JOIN gold.dim_branches AS b
    ON f.branch_key = b.branch_key
WHERE b.branch_key IS NULL;


SELECT f.transaction_type_id
FROM gold.fact_transactions AS f
LEFT JOIN gold.dim_transactiontypes AS t
    ON f.transaction_type_id = t.type_id
WHERE t.type_id IS NULL;
---------------------------------------------------------
-- [7] gold.fact_loans --

SELECT loan_id, COUNT(*) AS loan_count
FROM gold.fact_loans
GROUP BY loan_id
HAVING COUNT(*) > 1;


SELECT *
FROM gold.fact_loans
WHERE account_key IS NULL
   OR status_id IS NULL;


SELECT f.account_key
FROM gold.fact_loans AS f
LEFT JOIN gold.dim_accounts AS a
    ON f.account_key = a.account_key
WHERE a.account_key IS NULL;

